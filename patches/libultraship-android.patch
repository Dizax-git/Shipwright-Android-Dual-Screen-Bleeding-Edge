+From 0000000000000000000000000000000000000004 Mon Sep 17 00:00:00 2001
+From: android-port <noreply@example.com>
+Date: Tue, 01 Apr 2025 00:00:00 +0000
+Subject: [PATCH 4/5] Android: skip virtual joysticks in gamepad scan
+
+Virtual joysticks (SDL_JoystickAttachVirtual) get SDL index 0 on
+activity resume, pushing the physical controller to index 1. ImGui
+AutoFirst then polls the virtual joystick for BACK — never pressed
+by hardware — breaking the SoH menu toggle. Skip virtual devices.
+---
+ backends/imgui_impl_sdl2.cpp | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/backends/imgui_impl_sdl2.cpp b/backends/imgui_impl_sdl2.cpp
+--- a/backends/imgui_impl_sdl2.cpp
++++ b/backends/imgui_impl_sdl2.cpp
+@@ -835,7 +835,7 @@ static void ImGui_ImplSDL2_UpdateGamepads()
+         ImGui_ImplSDL2_CloseGamepads();
+         int joystick_count = SDL_NumJoysticks();
+         for (int n = 0; n < joystick_count; n++)
+-            if (SDL_IsGameController(n))
++            if (SDL_IsGameController(n) && !SDL_JoystickIsVirtual(n))
+                 if (SDL_GameController* gamepad = SDL_GameControllerOpen(n))
+                 {
+                     bd->Gamepads.push_back(gamepad);
+
+From 0000000000000000000000000000000000000005 Mon Sep 17 00:00:00 2001
+From: android-port <noreply@example.com>
+Date: Tue, 01 Apr 2025 00:00:00 +0000
+Subject: [PATCH 5/5] Android: rescan gamepads on window focus regained
+
+After startActivityForResult returns (file picker, permissions), SDL may
+fire CONTROLLERDEVICEREMOVED (clearing bd->Gamepads) but not
+CONTROLLERDEVICEADDED for a physically always-connected controller.
+Force a gamepad rescan on the next frame whenever focus is regained.
+---
+ backends/imgui_impl_sdl2.cpp | 6 +++++-
+ 1 file changed, 5 insertions(+), 1 deletion(-)
+
+diff --git a/backends/imgui_impl_sdl2.cpp b/backends/imgui_impl_sdl2.cpp
+--- a/backends/imgui_impl_sdl2.cpp
++++ b/backends/imgui_impl_sdl2.cpp
+@@ -480,7 +480,12 @@ bool ImGui_ImplSDL2_ProcessEvent(const SDL_Event* event)
+             if (window_event == SDL_WINDOWEVENT_FOCUS_GAINED)
+-                io.AddFocusEvent(true);
+-            else if (window_event == SDL_WINDOWEVENT_FOCUS_LOST)
++            {
++                io.AddFocusEvent(true);
++#if defined(__ANDROID__)
++                bd->WantUpdateGamepadsList = true;
++#endif
++            }
++            else if (window_event == SDL_WINDOWEVENT_FOCUS_LOST)
+                 io.AddFocusEvent(false);
+             else if (window_event == SDL_WINDOWEVENT_CLOSE)
+                 viewport->PlatformRequestClose = true;
+             else if (window_event == SDL_WINDOWEVENT_MOVED)

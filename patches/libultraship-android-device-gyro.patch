     }
 
+#ifdef __ANDROID__
+    {
+        float gyroData[3];
+        if (ReadAndroidDeviceGyro(gyroData)) {
+            mNeutralPitch = gyroData[0];
+            mNeutralYaw = gyroData[1];
+            mNeutralRoll = gyroData[2];
+            return;
+        }
+    }
+#endif
+
     // if we didn't find a gyro device zero everything out
     mNeutralPitch = 0;
     mNeutralYaw = 0;
@@ -66,6 +107,17 @@ void SDLGyroMapping::UpdatePad(float& x, float& y) {

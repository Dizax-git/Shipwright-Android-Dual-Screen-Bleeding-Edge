 namespace Ship {
+#ifdef __ANDROID__
+// Handhelds such as the AYN Thor expose their gyroscope as an Android device sensor,
+// not as a sensor of the built-in game controller. Fall back to it when no gamepad has one.
+//
+// The sensor sends ~60 samples a second but the game reads the pad once per game
+// frame (20 Hz in OoT): reading only the latest sample threw two thirds of the
+// motion away and kept its noise. Every sample is collected (SDL_SENSORUPDATE
+// event watch) and the game gets their average since its previous read.
+// The accelerometer gives the gravity direction for "player space" aiming.
+namespace {
+struct AndroidMotion {
+    std::mutex mutex;
+    SDL_SensorID gyroId = -1;
+    SDL_SensorID accelId = -1;
+    double sum[3] = { 0.0, 0.0, 0.0 };
+    int count = 0;
+    float last[3] = { 0.0f, 0.0f, 0.0f };
+    bool hasLast = false;
+    float slow[3] = { 0.0f, 0.0f, 0.0f }; // ~1 s running average, for Recalibrate
+    bool hasSlow = false;
+    float grav[3] = { 0.0f, 0.0f, 0.0f }; // low-passed accelerometer (points up)
+    bool hasGrav = false;
+};
+AndroidMotion sMotion;
+SDL_Sensor* sGyroSensor = nullptr;
+bool sMotionTried = false;
+
+int SDLCALL MotionEventWatch(void*, SDL_Event* event) {
+    if (event->type != SDL_SENSORUPDATE) {
+        return 0;
+    }
+    const float* d = event->sensor.data;
+    std::lock_guard<std::mutex> lock(sMotion.mutex);
+    if (event->sensor.which == sMotion.gyroId) {
+        for (int i = 0; i < 3; i++) {
+            sMotion.sum[i] += d[i];
+            sMotion.slow[i] = sMotion.hasSlow ? sMotion.slow[i] + (d[i] - sMotion.slow[i]) / 60.0f : d[i];
+        }
+        sMotion.count++;
+        sMotion.hasSlow = true;
+    } else if (event->sensor.which == sMotion.accelId) {
+        for (int i = 0; i < 3; i++) {
+            sMotion.grav[i] = sMotion.hasGrav ? sMotion.grav[i] + (d[i] - sMotion.grav[i]) * 0.1f : d[i];
+        }
+        sMotion.hasGrav = true;
+    }
+    return 0;
+}
+
+SDL_Sensor* GetAndroidDeviceGyro() {
+    if (!sMotionTried) {
+        sMotionTried = true;
+        if (SDL_WasInit(SDL_INIT_SENSOR) == 0 && SDL_InitSubSystem(SDL_INIT_SENSOR) != 0) {
+            SPDLOG_WARN("Gyro: could not init SDL sensors: {}", SDL_GetError());
+            return nullptr;
+        }
+        SDL_Sensor* accel = nullptr;
+        for (int i = 0; i < SDL_NumSensors(); i++) {
+            const SDL_SensorType type = SDL_SensorGetDeviceType(i);
+            if (type == SDL_SENSOR_GYRO && sGyroSensor == nullptr) {
+                sGyroSensor = SDL_SensorOpen(i);
+                SPDLOG_INFO("Gyro: using Android device sensor '{}'", SDL_SensorGetDeviceName(i));
+            } else if (type == SDL_SENSOR_ACCEL && accel == nullptr) {
+                accel = SDL_SensorOpen(i);
+                SPDLOG_INFO("Gyro: gravity from Android device sensor '{}'", SDL_SensorGetDeviceName(i));
+            }
+        }
+        {
+            std::lock_guard<std::mutex> lock(sMotion.mutex);
+            sMotion.gyroId = sGyroSensor != nullptr ? SDL_SensorGetInstanceID(sGyroSensor) : -1;
+            sMotion.accelId = accel != nullptr ? SDL_SensorGetInstanceID(accel) : -1;
+        }
+        if (sGyroSensor != nullptr) {
+            SDL_EventState(SDL_SENSORUPDATE, SDL_ENABLE);
+            SDL_AddEventWatch(MotionEventWatch, nullptr);
+        }
+    }
+    return sGyroSensor;
+}
+
+// Average angular rate (rad/s) since the previous read, and the gravity direction
+// (unit vector, pointing up) when known.
+bool ReadAndroidDeviceGyro(float* gyroData, float* gravity = nullptr, bool* hasGravity = nullptr) {
+    SDL_Sensor* sensor = GetAndroidDeviceGyro();
+    if (sensor == nullptr) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(sMotion.mutex);
+    if (sMotion.count > 0) {
+        for (int i = 0; i < 3; i++) {
+            sMotion.last[i] = static_cast<float>(sMotion.sum[i] / sMotion.count);
+            sMotion.sum[i] = 0.0;
+        }
+        sMotion.count = 0;
+        sMotion.hasLast = true;
+    }
+    if (sMotion.hasLast) {
+        for (int i = 0; i < 3; i++) {
+            gyroData[i] = sMotion.last[i];
+        }
+    } else if (SDL_SensorGetData(sensor, gyroData, 3) != 0) {
+        return false;
+    }
+    if (gravity != nullptr && hasGravity != nullptr) {
+        const float len = std::sqrt(sMotion.grav[0] * sMotion.grav[0] + sMotion.grav[1] * sMotion.grav[1] +
+                                    sMotion.grav[2] * sMotion.grav[2]);
+        *hasGravity = sMotion.hasGrav && len > 1.0f;
+        for (int i = 0; i < 3; i++) {
+            gravity[i] = *hasGravity ? sMotion.grav[i] / len : 0.0f;
+        }
+    }
+    return true;
+}
+
+// Rest value of the gyro over the last second (for Recalibrate).
+bool ReadAndroidDeviceGyroRest(float* gyroData) {
+    if (GetAndroidDeviceGyro() == nullptr) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(sMotion.mutex);
+    if (!sMotion.hasSlow) {
+        return false;
+    }
+    for (int i = 0; i < 3; i++) {
+        gyroData[i] = sMotion.slow[i];
+    }
+    return true;
+}
+} // namespace
+#endif
